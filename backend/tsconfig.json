{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "rootDir": "./src",
    "outDir": "./dist",
    
    
    // Habilita a leitura dos tipos do Node e Express instalados no node_modules
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Opções de checagem estrita
    "strict": true,
    "strictPropertyInitialization": false, // <-- Desativa a exigência de inicializador/exclamação nas propriedades
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    // Suporte aos Decorators do class-validator
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}