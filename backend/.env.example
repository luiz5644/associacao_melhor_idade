# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=associacao_melhor_idade

# Autenticação JWT (obrigatório)
JWT_SECRET=

# Servidor e CORS
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Opcional: URL pública usada no link de recuperação de senha.
# Se vazia, usa a primeira origem de FRONTEND_URL.
FRONTEND_PUBLIC_URL=

# Envio de E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
